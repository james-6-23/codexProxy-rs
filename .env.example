# Codex Proxy 环境变量配置示例
# 复制此文件为 .env.local 并修改配置

# ============================================================
# 应用配置
# ============================================================

# 服务端口
CODEX_PORT=8080

# 管理员密钥（必须修改！）
ADMIN_SECRET=change-me-in-production

# 代理 URL（可选）
PROXY_URL=

# ============================================================
# 数据库配置
# ============================================================

# PostgreSQL 用户名
POSTGRES_USER=codex

# PostgreSQL 密码（生产环境请使用强密码）
POSTGRES_PASSWORD=codex

# 数据库名称
POSTGRES_DB=codex2api

# ============================================================
# 系统配置
# ============================================================

# 时区
TZ=Asia/Shanghai

# 日志级别 (trace, debug, info, warn, error)
RUST_LOG=info

# Rust 错误回溯 (0=关闭, 1=开启)
RUST_BACKTRACE=0

# ============================================================
# 备份配置
# ============================================================

# 备份保留天数
BACKUP_KEEP_DAYS=7
